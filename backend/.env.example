# Copy to .env and fill with real values. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Required only when profile image uploads are enabled
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required to send verification, password reset, welcome, and invitation emails.
# Use the Server API Token from Postmark and a confirmed sender signature/domain.
POSTMARK_SERVER_TOKEN=
# Set this to your actual confirmed sender address; do not use example.com.
POSTMARK_FROM=
POSTMARK_MESSAGE_STREAM=outbound

# Optional HR AI advice. Keep the key only on the backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
